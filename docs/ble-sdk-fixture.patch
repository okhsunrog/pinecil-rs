diff --git a/customer_app/bl702_demo_event/bl702_demo_event/forensics.c b/customer_app/bl702_demo_event/bl702_demo_event/forensics.c
new file mode 100644
index 0000000..58c5277
--- /dev/null
+++ b/customer_app/bl702_demo_event/bl702_demo_event/forensics.c
@@ -0,0 +1,13 @@
+#include <stdint.h>
+volatile uint32_t SDK_IRQ_COUNT, SDK_IRQ_MAX_US;
+volatile uint32_t SDK_CONNECTED, SDK_DISCONNECTED, SDK_HEARTBEAT;
+extern void __real_rwble_isr(void);
+void __wrap_rwble_isr(void) {
+    uint32_t start, end;
+    __asm__ volatile ("csrr %0, mcycle" : "=r"(start));
+    __real_rwble_isr();
+    __asm__ volatile ("csrr %0, mcycle" : "=r"(end));
+    uint32_t elapsed = (end - start) / 144;
+    SDK_IRQ_COUNT++;
+    if (elapsed > SDK_IRQ_MAX_US) SDK_IRQ_MAX_US = elapsed;
+}
